diff --git a/src/render_helpers/software_gamma.rs b/src/render_helpers/software_gamma.rs
new file mode 100644
index 0000000..a692dff
--- /dev/null
+++ b/src/render_helpers/software_gamma.rs
@@ -0,0 +1,466 @@
+//! Software fallback for `zwlr_gamma_control_v1`.
+//!
+//! Some display controllers have no `GAMMA_LUT` CRTC property at all (the Apple
+//! DCP on Apple Silicon is the notable one: it only exposes `CTM`, and a 3×3
+//! matrix cannot express the 3×1D ramps of the protocol). On those, hardware
+//! gamma is simply unavailable and every night-light tool fails.
+//!
+//! This applies the ramp in the render pipeline instead: the composited output
+//! is captured into a texture and drawn back through a shader that looks every
+//! channel up in the ramp. Same idea as the wlroots software gamma fallback.
+//!
+//! The cost is that the whole output has to be recomposited whenever anything on
+//! it changes (a framebuffer effect covering the output cannot use partial
+//! damage), and that direct scanout is disabled while a ramp is set. Nothing is
+//! drawn, and nothing is paid for, when no client set a ramp.
+
+use std::cell::RefCell;
+use std::sync::Arc;
+
+use smithay::backend::allocator::Fourcc;
+use smithay::backend::renderer::element::{Element, Id, RenderElement};
+use smithay::backend::renderer::gles::{
+    ffi, GlesError, GlesFrame, GlesRenderer, GlesTexture, Uniform, UniformValue,
+};
+use smithay::backend::renderer::utils::CommitCounter;
+use smithay::backend::renderer::{
+    Frame as _, FrameContext, ImportMem as _, Offscreen, Texture as _,
+};
+use smithay::gpu_span_location;
+use smithay::utils::user_data::UserDataMap;
+use smithay::utils::{Buffer, Logical, Physical, Rectangle, Scale, Size, Transform};
+
+use crate::backend::tty::{TtyFrame, TtyRenderer, TtyRendererError};
+use crate::render_helpers::renderer::AsGlesFrame as _;
+use crate::render_helpers::shaders::Shaders;
+
+/// Ramp size advertised to gamma control clients when there's no hardware LUT.
+///
+/// One entry per 8-bit input level, which is exactly what the framebuffer can
+/// feed the shader, so this loses nothing compared to a bigger ramp.
+pub const GAMMA_SIZE: u32 = 256;
+
+/// Gamma ramp converted into the RGBA8 texture data of the LUT.
+#[derive(Debug)]
+struct Lut {
+    /// `GAMMA_SIZE` RGBA texels.
+    data: Vec<u8>,
+    /// Bumped on every change; used to re-upload the cached texture.
+    serial: u64,
+}
+
+/// Per-output software gamma state.
+#[derive(Debug)]
+pub struct SoftwareGamma {
+    id: Id,
+    commit: CommitCounter,
+    lut: Option<Arc<Lut>>,
+    next_serial: u64,
+}
+
+#[derive(Debug)]
+pub struct SoftwareGammaElement {
+    id: Id,
+    commit: CommitCounter,
+    geometry: Rectangle<f64, Logical>,
+    lut: Arc<Lut>,
+}
+
+#[derive(Debug, Default)]
+struct Inner {
+    /// Copy of the framebuffer below the element.
+    framebuffer: Option<GlesTexture>,
+    /// The ramp uploaded as a `GAMMA_SIZE` × 1 texture.
+    lut: Option<GlesTexture>,
+    /// Serial of the ramp currently in `lut`.
+    lut_serial: u64,
+    /// Whether the last capture succeeded.
+    captured: bool,
+}
+
+impl SoftwareGamma {
+    pub fn new() -> Self {
+        Self {
+            id: Id::new(),
+            commit: CommitCounter::default(),
+            lut: None,
+            next_serial: 1,
+        }
+    }
+
+    pub fn is_active(&self) -> bool {
+        self.lut.is_some()
+    }
+
+    /// Sets the gamma ramp, `None` to go back to no color transformation.
+    ///
+    /// Returns whether anything changed, i.e. whether a redraw is needed.
+    pub fn set_ramp(&mut self, ramp: Option<&[u16]>) -> bool {
+        let size = GAMMA_SIZE as usize;
+
+        let data = match ramp {
+            Some(ramp) => {
+                if ramp.len() != size * 3 {
+                    error!("wrong software gamma ramp length: {}", ramp.len());
+                    None
+                } else {
+                    let (red, rest) = ramp.split_at(size);
+                    let (green, blue) = rest.split_at(size);
+
+                    let mut data = Vec::with_capacity(size * 4);
+                    let mut identity = true;
+                    for i in 0..size {
+                        let (r, g, b) = (to_u8(red[i]), to_u8(green[i]), to_u8(blue[i]));
+                        // With one ramp entry per 8-bit level, a ramp that maps
+                        // every level onto itself is a no-op on the 8-bit
+                        // framebuffer. Clients leave such a ramp set whenever
+                        // night light is scheduled but currently inactive, and
+                        // rendering it would cost a full-output recomposite on
+                        // every frame for nothing.
+                        identity &= u32::from(r) == i as u32
+                            && u32::from(g) == i as u32
+                            && u32::from(b) == i as u32;
+
+                        data.push(r);
+                        data.push(g);
+                        data.push(b);
+                        data.push(u8::MAX);
+                    }
+
+                    if identity {
+                        trace!("identity software gamma ramp, not rendering it");
+                        None
+                    } else {
+                        Some(data)
+                    }
+                }
+            }
+            None => None,
+        };
+
+        match (&self.lut, &data) {
+            (None, None) => return false,
+            (Some(lut), Some(data)) if lut.data == *data => return false,
+            _ => (),
+        }
+
+        self.lut = data.map(|data| {
+            let serial = self.next_serial;
+            self.next_serial += 1;
+            Arc::new(Lut { data, serial })
+        });
+        self.commit.increment();
+
+        true
+    }
+
+    pub fn render(&self, output_size: Size<f64, Logical>) -> Option<SoftwareGammaElement> {
+        let lut = self.lut.clone()?;
+        Some(SoftwareGammaElement {
+            id: self.id.clone(),
+            commit: self.commit,
+            geometry: Rectangle::from_size(output_size),
+            lut,
+        })
+    }
+}
+
+impl Default for SoftwareGamma {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+fn to_u8(value: u16) -> u8 {
+    ((u32::from(value) * 255 + 32767) / 65535) as u8
+}
+
+impl Element for SoftwareGammaElement {
+    fn id(&self) -> &Id {
+        &self.id
+    }
+
+    fn current_commit(&self) -> CommitCounter {
+        self.commit
+    }
+
+    fn src(&self) -> Rectangle<f64, Buffer> {
+        Rectangle::from_size(self.geometry.size.to_buffer(1., Transform::Normal))
+    }
+
+    fn geometry(&self, scale: Scale<f64>) -> Rectangle<i32, Physical> {
+        self.geometry.to_physical_precise_round(scale)
+    }
+
+    fn is_framebuffer_effect(&self) -> bool {
+        true
+    }
+}
+
+impl RenderElement<GlesRenderer> for SoftwareGammaElement {
+    fn capture_framebuffer(
+        &self,
+        frame: &mut GlesFrame<'_, '_>,
+        _src: Rectangle<f64, Buffer>,
+        dst: Rectangle<i32, Physical>,
+        cache: &UserDataMap,
+    ) -> Result<(), GlesError> {
+        let _span = tracy_client::span!("SoftwareGammaElement::capture_framebuffer");
+        let location = gpu_span_location!("SoftwareGammaElement::capture_framebuffer");
+        frame.with_gpu_span(location, |frame| {
+            let output_rect = Rectangle::from_size(frame.output_size());
+            let transform = frame.transformation();
+
+            let mut guard = frame.renderer();
+
+            let inner = cache.get_or_insert::<RefCell<Inner>, _>(|| RefCell::new(Inner::default()));
+            let mut inner = inner.borrow_mut();
+            let inner = &mut *inner;
+
+            inner.captured = false;
+
+            // Clamp to the framebuffer: glBlitFramebuffer skips out-of-bounds
+            // pixels. The element normally covers the output exactly, this is
+            // just in case rounding makes it a pixel bigger.
+            let Some(clamped_dst) = dst.intersection(output_rect) else {
+                return Ok(());
+            };
+
+            // Framebuffer coordinates of the region we're capturing.
+            let src_rect = transform.transform_rect_in(clamped_dst, &output_rect.size);
+            let size = src_rect.size.to_logical(1).to_buffer(1, Transform::Normal);
+
+            // Recreate the framebuffer copy if the size changed.
+            if inner
+                .framebuffer
+                .as_ref()
+                .is_some_and(|fb| fb.size() != size)
+            {
+                inner.framebuffer = None;
+            }
+            let framebuffer = if let Some(fb) = &inner.framebuffer {
+                fb
+            } else {
+                trace!("creating gamma framebuffer texture {} × {}", size.w, size.h);
+                let renderer = guard.as_mut();
+                let texture = renderer.create_buffer(Fourcc::Abgr8888, size)?;
+                inner.framebuffer.insert(texture)
+            };
+            let framebuffer_id = framebuffer.tex_id();
+
+            // Upload the ramp if it changed.
+            if inner.lut.is_none() || inner.lut_serial != self.lut.serial {
+                let renderer = guard.as_mut();
+                let size = Size::from((GAMMA_SIZE as i32, 1));
+                let texture =
+                    renderer.import_memory(&self.lut.data, Fourcc::Abgr8888, size, false)?;
+
+                // import_memory() leaves the default GL_NEAREST_MIPMAP_LINEAR
+                // min filter, which makes the texture incomplete (we have no
+                // mipmaps) and samples black. We also want no interpolation
+                // between ramp entries.
+                let tex_id = texture.tex_id();
+                renderer.with_context(|gl| unsafe {
+                    gl.BindTexture(ffi::TEXTURE_2D, tex_id);
+                    gl.TexParameteri(
+                        ffi::TEXTURE_2D,
+                        ffi::TEXTURE_MIN_FILTER,
+                        ffi::NEAREST as i32,
+                    );
+                    gl.TexParameteri(
+                        ffi::TEXTURE_2D,
+                        ffi::TEXTURE_MAG_FILTER,
+                        ffi::NEAREST as i32,
+                    );
+                    gl.BindTexture(ffi::TEXTURE_2D, 0);
+                })?;
+
+                inner.lut = Some(texture);
+                inner.lut_serial = self.lut.serial;
+            }
+
+            // We can't use renderer.with_context() as that will reset the GlesFrame binding that we
+            // want to blit from.
+            drop(guard);
+
+            frame.with_context(|gl| unsafe {
+                while gl.GetError() != ffi::NO_ERROR {}
+
+                let mut current_fbo = 0i32;
+                gl.GetIntegerv(ffi::DRAW_FRAMEBUFFER_BINDING, &mut current_fbo as *mut _);
+
+                // BlitFramebuffer is affected by the scissor test, we don't want that.
+                gl.Disable(ffi::SCISSOR_TEST);
+
+                let mut fbo = 0;
+                gl.GenFramebuffers(1, &mut fbo as *mut _);
+                gl.BindFramebuffer(ffi::DRAW_FRAMEBUFFER, fbo);
+
+                gl.FramebufferTexture2D(
+                    ffi::DRAW_FRAMEBUFFER,
+                    ffi::COLOR_ATTACHMENT0,
+                    ffi::TEXTURE_2D,
+                    framebuffer_id,
+                    0,
+                );
+
+                gl.BlitFramebuffer(
+                    src_rect.loc.x,
+                    src_rect.loc.y,
+                    src_rect.loc.x + src_rect.size.w,
+                    src_rect.loc.y + src_rect.size.h,
+                    0,
+                    0,
+                    size.w,
+                    size.h,
+                    ffi::COLOR_BUFFER_BIT,
+                    ffi::NEAREST,
+                );
+
+                // Restore state set by GlesFrame that we just modified.
+                gl.BindFramebuffer(ffi::DRAW_FRAMEBUFFER, current_fbo as u32);
+                gl.Enable(ffi::SCISSOR_TEST);
+
+                gl.DeleteFramebuffers(1, &mut fbo as *mut _);
+
+                if gl.GetError() != ffi::NO_ERROR {
+                    Err(GlesError::BlitError)
+                } else {
+                    Ok(())
+                }
+            })??;
+
+            inner.captured = true;
+
+            Ok(())
+        })
+    }
+
+    fn draw(
+        &self,
+        frame: &mut GlesFrame<'_, '_>,
+        _src: Rectangle<f64, Buffer>,
+        dst: Rectangle<i32, Physical>,
+        damage: &[Rectangle<i32, Physical>],
+        _opaque_regions: &[Rectangle<i32, Physical>],
+        cache: Option<&UserDataMap>,
+    ) -> Result<(), GlesError> {
+        let Some(cache) = cache else {
+            return Ok(());
+        };
+        let Some(inner) = cache.get::<RefCell<Inner>>() else {
+            return Ok(());
+        };
+        let inner = inner.borrow();
+
+        if !inner.captured {
+            return Ok(());
+        }
+        let (Some(texture), Some(lut)) = (&inner.framebuffer, &inner.lut) else {
+            return Ok(());
+        };
+
+        // Without the shader we can't transform anything; leave the framebuffer
+        // as it is rather than drawing an untransformed copy over itself.
+        let Some(program) = Shaders::get_from_frame(frame).gamma_lut.clone() else {
+            return Ok(());
+        };
+
+        // Clamp the same way as in capture_framebuffer().
+        let output_rect = Rectangle::from_size(frame.output_size());
+        let Some(clamped_dst) = dst.intersection(output_rect) else {
+            return Ok(());
+        };
+        let clamp_offset = clamped_dst.loc - dst.loc;
+
+        let mut damage = damage.to_vec();
+        if clamped_dst != dst {
+            let r = Rectangle::new(clamp_offset, clamped_dst.size);
+            damage.retain_mut(|d| {
+                if let Some(mut crop) = d.intersection(r) {
+                    crop.loc -= clamp_offset;
+                    *d = crop;
+                    true
+                } else {
+                    false
+                }
+            });
+        }
+        if damage.is_empty() {
+            return Ok(());
+        }
+
+        let size = GAMMA_SIZE as f32;
+        let uniforms = [
+            Uniform::new("gamma_lut", UniformValue::_1i(1)),
+            Uniform::new("gamma_lut_coords", ((size - 1.) / size, 0.5 / size)),
+        ];
+
+        // The shader samples the ramp from texture unit 1; unit 0 is the
+        // captured framebuffer, bound by render_texture_from_to() below.
+        let lut_id = lut.tex_id();
+        frame.with_context(|gl| unsafe {
+            gl.ActiveTexture(ffi::TEXTURE1);
+            gl.BindTexture(ffi::TEXTURE_2D, lut_id);
+            gl.ActiveTexture(ffi::TEXTURE0);
+        })?;
+
+        let transform = frame.transformation().invert();
+        let res = frame.render_texture_from_to(
+            texture,
+            Rectangle::from_size(texture.size().to_f64()),
+            clamped_dst,
+            &damage,
+            &[],
+            // The captured texture has the same transform as the frame.
+            transform,
+            1.,
+            Some(&program),
+            &uniforms,
+        );
+
+        frame.with_context(|gl| unsafe {
+            gl.ActiveTexture(ffi::TEXTURE1);
+            gl.BindTexture(ffi::TEXTURE_2D, 0);
+            gl.ActiveTexture(ffi::TEXTURE0);
+        })?;
+
+        res
+    }
+}
+
+impl<'render> RenderElement<TtyRenderer<'render>> for SoftwareGammaElement {
+    fn capture_framebuffer(
+        &self,
+        frame: &mut TtyFrame<'_, '_, '_>,
+        src: Rectangle<f64, Buffer>,
+        dst: Rectangle<i32, Physical>,
+        cache: &UserDataMap,
+    ) -> Result<(), TtyRendererError<'render>> {
+        let gles_frame = frame.as_gles_frame();
+        RenderElement::<GlesRenderer>::capture_framebuffer(&self, gles_frame, src, dst, cache)?;
+        Ok(())
+    }
+
+    fn draw(
+        &self,
+        frame: &mut TtyFrame<'_, '_, '_>,
+        src: Rectangle<f64, Buffer>,
+        dst: Rectangle<i32, Physical>,
+        damage: &[Rectangle<i32, Physical>],
+        opaque_regions: &[Rectangle<i32, Physical>],
+        cache: Option<&UserDataMap>,
+    ) -> Result<(), TtyRendererError<'render>> {
+        let gles_frame = frame.as_gles_frame();
+        RenderElement::<GlesRenderer>::draw(
+            &self,
+            gles_frame,
+            src,
+            dst,
+            damage,
+            opaque_regions,
+            cache,
+        )?;
+        Ok(())
+    }
+}
