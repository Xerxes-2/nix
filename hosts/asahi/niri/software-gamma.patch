diff --git a/src/render_helpers/shaders/gamma_lut.frag b/src/render_helpers/shaders/gamma_lut.frag
new file mode 100644
index 0000000..e9afbb3
--- /dev/null
+++ b/src/render_helpers/shaders/gamma_lut.frag
@@ -0,0 +1,55 @@
+#version 100
+
+//_DEFINES_
+
+#if defined(EXTERNAL)
+#extension GL_OES_EGL_image_external : require
+#endif
+
+precision highp float;
+#if defined(EXTERNAL)
+uniform samplerExternalOES tex;
+#else
+uniform sampler2D tex;
+#endif
+
+uniform float alpha;
+varying vec2 v_coords;
+
+#if defined(DEBUG_FLAGS)
+uniform float tint;
+#endif
+
+// Gamma ramp as a lut_size × 1 texture: one texel per input level, the three
+// output channels in R, G and B.
+uniform sampler2D gamma_lut;
+// x = (lut_size - 1) / lut_size, y = 0.5 / lut_size; maps a [0, 1] color
+// channel onto the center of its texel.
+uniform vec2 gamma_lut_coords;
+
+void main() {
+    // Sample the captured framebuffer. It is opaque, so premultiplied and
+    // straight alpha are the same thing here.
+    vec4 color = texture2D(tex, v_coords);
+#if defined(NO_ALPHA)
+    color = vec4(color.rgb, 1.0);
+#endif
+
+    vec3 coords = clamp(color.rgb, 0.0, 1.0) * gamma_lut_coords.x + gamma_lut_coords.y;
+    color.r = texture2D(gamma_lut, vec2(coords.r, 0.5)).r;
+    color.g = texture2D(gamma_lut, vec2(coords.g, 0.5)).g;
+    color.b = texture2D(gamma_lut, vec2(coords.b, 0.5)).b;
+    // We are drawing over the very pixels we sampled, so replace rather than
+    // blend with them, whatever alpha they happened to have.
+    color.a = 1.0;
+
+    // Apply final alpha and tint.
+    color = color * alpha;
+
+#if defined(DEBUG_FLAGS)
+    if (tint == 1.0)
+        color = vec4(0.0, 0.2, 0.0, 0.2) + color * 0.8;
+#endif
+
+    gl_FragColor = color;
+}
